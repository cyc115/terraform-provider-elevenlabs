# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is .gitignored — never commit a file containing real secrets.

elevenlabs_api_key = "sk_REPLACE_WITH_YOUR_KEY"
webhook_name       = "my-webhook"
webhook_url        = "https://your-domain.example.com/webhook/elevenlabs"
phone_number       = "+15551234567"
phone_label        = "my-phone"
